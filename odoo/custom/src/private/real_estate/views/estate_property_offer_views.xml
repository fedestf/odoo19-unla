<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_offer_list_view" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Ofertas">
                <field name="price"/>
                <field name="partner_id"/>
                <field name="status"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <button name="action_accept" type="object" string="Aceptar"
                    icon="fa-check" invisible="status == 'accepted'"/>
            </list>
        </field>
    </record>
    <record id="estate_property_offer_form_view" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Oferta">
                <sheet>
                    <group>
                        <group>
                            <field name="price"/>
                            <field name="partner_id"/>
                            <field name="property_id"/>
                            <field name="property_type_id"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="validity"/>
                            <field name="date_deadline"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="estate_property_offer_search_view" model="ir.ui.view">
        <field name="name">estate.property.offer.search</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <search string="Buscar ofertas">
                <field name="property_id"/>
                <field name="partner_id"/>
                <field name="property_type_id"/>
                <group>
                    <filter name="group_by_property_type" string="Tipo de propiedad"
                        context="{'group_by': 'property_type_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">Ofertas</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="estate_property_offer_search_view"/>
    </record>
</odoo>
