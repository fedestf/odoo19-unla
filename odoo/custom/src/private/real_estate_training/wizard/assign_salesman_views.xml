<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assign_salesman_wizard_form" model="ir.ui.view">
        <field name="name">estate.assign.salesman.wizard.form</field>
        <field name="model">estate.assign.salesman.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign salesperson">
                <group>
                    <field name="property_ids" widget="many2many_tags"/>
                    <field name="salesman_id"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_assign_salesman_wizard" model="ir.actions.act_window">
        <field name="name">Assign salesperson</field>
        <field name="res_model">estate.assign.salesman.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_assign_salesman_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="real_estate.model_estate_property"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('real_estate.group_estate_property_manager'))]"/>
    </record>
</odoo>
