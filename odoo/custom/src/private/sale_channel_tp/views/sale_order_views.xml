<odoo>
    <record id="sale_order_channel_form" model="ir.ui.view">
        <field name="name">sale.order.channel.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="sale_channel_id" readonly="state not in ['draft', 'sent']"
                       options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='warehouse_id']" position="attributes">
                <attribute name="readonly">True</attribute>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="readonly">True</attribute>
            </xpath>
        </field>
    </record>
    <record id="sale_order_channel_list" model="ir.ui.view">
        <field name="name">sale.order.channel.list</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='partner_id']" position="after">
                <field name="sale_channel_id" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="sale_order_channel_search" model="ir.ui.view">
        <field name="name">sale.order.channel.search</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="sale_channel_id"/>
                <filter name="group_by_sale_channel_tp" string="Canal de venta" context="{'group_by': 'sale_channel_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
